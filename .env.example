# Required: your Entra ID (Azure AD) tenant GUID, or a verified domain.
MINITEAMS_TENANT_ID=00000000-0000-0000-0000-000000000000

# Optional overrides — defaults are the purple-teams work/TFW constants.
# Change ONLY if auth/handshakes start returning 4xx, then re-capture from a live
# teams.microsoft.com browser session (DevTools → Network → authorize request).
# MINITEAMS_CLIENT_ID=1fec8e78-bce4-4aaf-ab1b-5451cc387264
# MINITEAMS_OAUTH_SCOPE=https://api.spaces.skype.com/.default
# MINITEAMS_USE_DEVICE_CODE=false
# MINITEAMS_LOG_LEVEL=INFO
# Custom emoji host (default: the fr-prod region).
# MINITEAMS_ASYNCGW_HOST=fr-prod.asyncgw.teams.microsoft.com
# Run dir for the web launch files (created 0700). Snap browsers (e.g. snap Chromium) cannot read
# /run/user/<uid> or hidden dirs like ~/.config: use a non-hidden dir.
# MINITEAMS_RUN_DIR=~/miniteams-run
