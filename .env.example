# Required: your Entra ID (Azure AD) tenant GUID, or a verified domain.
MINITEAMS_TENANT_ID=00000000-0000-0000-0000-000000000000

# Optional overrides — defaults are the purple-teams work/TFW constants.
# Change ONLY if auth/handshakes start returning 4xx, then re-capture from a live
# teams.microsoft.com browser session (DevTools → Network → authorize request).
# MINITEAMS_CLIENT_ID=1fec8e78-bce4-4aaf-ab1b-5451cc387264
# MINITEAMS_OAUTH_SCOPE=https://api.spaces.skype.com/.default
# MINITEAMS_USE_DEVICE_CODE=true   # false = browser sign-in (--browser-login)
# MINITEAMS_LOG_LEVEL=INFO
# Custom emoji host (default: the fr-prod region).
# MINITEAMS_ASYNCGW_HOST=fr-prod.asyncgw.teams.microsoft.com
# Second web / stream / archive --live instance: its own Trouter endpoint ids.
# MINITEAMS_ENDPOINT_SUFFIX=-test
# archive --live --verify-media: seconds between two chats of the media sweep.
# MINITEAMS_SWEEP_PAUSE=5

# Meeting follower (`follow`, `archive --live --follow`, spec 044). None is required: the paths default
# to where scripts/build-transcribe.sh puts them, under the cache dir (~/.cache/miniteams).
# MINITEAMS_STT_ENGINE=parakeet          # or whisper
# Absolute paths (no ~). Defaults: <cache dir>/transcribe/lib/libtranscribe.so,
# <cache dir>/models/parakeet/parakeet-ultra-Q8_0.gguf, <cache dir>/models/whisper-small
# MINITEAMS_TRANSCRIBE_LIBRARY=/path/to/libtranscribe.so
# MINITEAMS_PARAKEET_MODEL=/path/to/parakeet-ultra-Q8_0.gguf
# MINITEAMS_WHISPER_MODEL=/path/to/whisper-small
# STUN: a third party that sees this host's public address; empty for host candidates only.
# MINITEAMS_STUN_SERVER=stun.l.google.com:19302
# MINITEAMS_FOLLOW_LEAVE_GRACE_S=5       # wait for one of my devices to come back before leaving
# MINITEAMS_FOLLOW_REATTACH_DEADLINE_S=300   # keep re-attaching this long after a network outage
# MINITEAMS_FOLLOW_CAPTURE=/path/to/dir  # debug dump, audio included (as `follow --capture`); unset
# MINITEAMS_STT_ENGINE_PROCESSES=2
# MINITEAMS_STT_CPU_THREADS=2            # per engine process
# MINITEAMS_STT_ENGINE_TIMEOUT_S=60      # an engine silent this long is restarted
# MINITEAMS_STT_QUEUE_SIZE=64            # utterances waiting for an engine; more are dropped
# MINITEAMS_STT_QUIET_S=0.4              # a speaker silent this long gets silence fed
# MINITEAMS_STT_CLOSE_TIMEOUT_S=10       # at the call's end, the wait for the last lines
# MINITEAMS_VAD_MIN_SILENCE_MS=800       # silence that ends an utterance
# MINITEAMS_VAD_MAX_SPEECH_S=15          # longest utterance before a forced cut
# MINITEAMS_VAD_CUT_SEARCH_S=3           # forced cut: quietest window this far back, below the max
